@charset "utf-8";

@import url("https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Inter:wght@400;500;600;700;800&display=swap");

:root { color-scheme: dark; --bg: #08090b; --ink: #f5f5f5; --red: #e32636; --accent: #ff4857; --panel: #1a1d22; --muted: #a6abb3; --line: #292c32; --display: 'Barlow Condensed','Arial Narrow',Impact,sans-serif; --body: Inter,system-ui,sans-serif; }

* { box-sizing: border-box; }

html { scroll-behavior: smooth; }

body { margin: 0px; background: var(--bg); color: var(--ink); font: 1rem/1.65 var(--body); }

h1, h2, h3, p, figure { margin: 0px; }

h1, h2, h3, .brand strong { font-family: var(--display); line-height: 0.93; font-weight: 800; }

h2 { font-size: clamp(2.8rem, 5.4vw, 5.25rem); }

h3 { font-size: 1.65rem; line-height: 1.05; }

em { color: var(--accent); font-style: normal; }

a { color: inherit; text-decoration: none; }

button, input, select, textarea { font: inherit; }

button { cursor: pointer; }

img { max-width: 100%; display: block; }

small { font-size: 0.8125rem; }

.wrap { width: min(1280px, 100% - 96px); margin-inline: auto; }

.skip { position: absolute; z-index: 10; top: -100px; background: white; color: rgb(0, 0, 0); padding: 1rem; }

.skip:focus { top: 0px; }

:focus-visible { outline: rgb(255, 124, 134) solid 2px; outline-offset: 4px; }

.header { background: rgb(12, 13, 16); border-bottom: 1px solid rgb(40, 40, 43); position: relative; z-index: 3; }

.nav, .footer { min-height: 78px; display: flex; align-items: center; justify-content: space-between; gap: 1.4rem; }

.brand { display: inline-flex; gap: 0.55rem; align-items: center; line-height: 1; flex-shrink: 0; }

.brand small { font-size: 0.6875rem; font-weight: 800; letter-spacing: 0.16em; }

.brand strong { display: block; font-size: 2rem; letter-spacing: 0.03em; }

.brand strong span { color: var(--red); }

nav { display: flex; gap: clamp(1rem, 2.2vw, 2.4rem); align-items: center; }

nav a, .footer > a:last-child { font-size: 0.875rem; font-weight: 700; color: rgb(199, 201, 207); }

nav a:hover, nav a[aria-current] { color: rgb(255, 255, 255); }

nav a[aria-current] { box-shadow: 0 2px var(--red); padding-block: 0.45rem; }

.menu { display: none; }

.button { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0.7rem 1.2rem; font-size: 0.875rem; line-height: 1.3; font-weight: 800; border: 1px solid transparent; border-radius: 3px; transition: background 0.25s, border-color 0.25s, transform 0.25s; color: white; text-align: center; }

.button:hover { transform: translateY(-2px); }

.red { background: rgb(201, 30, 48); border-color: rgb(227, 38, 54); }

.red:hover { background: rgb(169, 20, 36); border-color: rgb(255, 72, 87); }

.outline { background: rgba(13, 16, 21, 0.65); border-color: rgb(101, 103, 109); }

.outline:hover { border-color: var(--accent); background: rgb(40, 16, 21); }

.hero { min-height: clamp(585px, 76vh, 850px); display: grid; align-items: center; position: relative; overflow: hidden; isolation: isolate; background: rgb(16, 14, 17); }

.hero-picture, .hero-shade { position: absolute; inset: 0px; z-index: -1; }

.hero-picture { background: url("assets/hero.webp") center 54% / cover no-repeat; transform: translateY(var(--parallax,0px)); will-change: transform; inset: -4% 0px; }

.hero-picture::after { content: ""; position: absolute; inset: 0px; background: url("assets/hero.webp") center 54% / cover no-repeat; animation: 2.9s cubic-bezier(0.16, 0.7, 0.22, 1) 0s 1 normal both running arrival; }

.hero-shade { background: linear-gradient(90deg, rgba(8, 9, 11, 0.97) 0%, rgba(8, 9, 11, 0.85) 24%, rgba(8, 9, 11, 0.44) 51%, transparent 80%), linear-gradient(0deg, rgb(8, 9, 11) 0%, transparent 28%); }

@keyframes arrival { 
  0% { transform: scale(1.15) translateX(3%); filter: brightness(0.64); }
  100% { transform: scale(1); filter: brightness(1); }
}

.hero-content { padding-block: 70px 110px; animation: 0.9s ease-out 0s 1 normal both running enter; }

@keyframes enter { 
  0% { transform: translateY(22px); opacity: 0; }
  100% { transform: none; opacity: 1; }
}

.eyebrow { display: flex; align-items: center; gap: 10px; color: var(--accent); letter-spacing: 0.14em; font-size: 0.8125rem; font-weight: 800; margin-bottom: 16px; }

.eyebrow::before { content: ""; width: 25px; height: 2px; background: currentcolor; flex: 0 0 auto; }

.hero h1 { font-size: clamp(4.3rem, 9vw, 9rem); letter-spacing: -0.015em; }

.hero-copy { color: rgb(223, 223, 226); font-size: 1.075rem; max-width: 410px; margin: 24px 0px 28px; }

.actions { display: flex; gap: 12px; flex-wrap: wrap; }

.hero-bottom { position: absolute; inset: auto 0px 22px; display: flex; justify-content: space-between; align-items: center; color: rgb(192, 194, 200); }

.hero-bottom a { font-size: 0.8125rem; font-weight: 700; }

.hero-bottom span { color: var(--accent); margin-right: 8px; }

.quick { border-block: 1px solid var(--line); background: rgb(18, 20, 24); }

.quick-grid { display: grid; grid-template-columns: repeat(3, 1fr); }

.quick-grid > * { display: flex; align-items: center; gap: 15px; padding: 18px 22px; border-left: 1px solid var(--line); }

.quick-grid > :last-child { border-right: 1px solid var(--line); }

.line-icon, .service-icon { display: grid; place-items: center; color: var(--accent); background: rgba(227, 38, 54, 0.082); border: 1px solid rgba(227, 38, 54, 0.314); width: 44px; height: 44px; border-radius: 3px; font-size: 1.5rem; flex: 0 0 auto; }

.quick strong, .quick small { display: block; line-height: 1.35; }

.quick small { color: var(--muted); margin-top: 4px; }

.section { padding-block: clamp(60px, 8vw, 112px); }

.section-head { display: flex; gap: 25px; justify-content: space-between; align-items: end; margin-bottom: 32px; }

.section-head > p { max-width: 340px; }

.section-head > p, .split-copy > p:not(.eyebrow), .booking p:not(.eyebrow), .contact p, .tech-options p, .service p, .footer p { color: var(--muted); }

.service-grid { display: grid; grid-template-columns: repeat(4, minmax(0px, 1fr)); gap: 14px; }

.service { background: rgb(19, 21, 26); border: 1px solid var(--line); border-radius: 4px; overflow: hidden; transition: border-color 0.25s, transform 0.25s; display: flex; flex-direction: column; }

.service[hidden] { display: none; }

.service:hover { border-color: rgb(169, 29, 44); transform: translateY(-3px); }

.service figure, .gallery-item figure { overflow: hidden; position: relative; }

.service img, .gallery-item img { width: 100%; aspect-ratio: 1.85 / 1; object-fit: cover; transition: transform 0.55s; background: rgb(37, 34, 41); }

.service:hover img, .gallery-item:hover img { transform: scale(1.06); }

figcaption, .service figure small { position: absolute; bottom: 8px; left: 8px; background: rgba(8, 9, 11, 0.875); color: rgb(238, 238, 238); padding: 2px 7px; font-size: 0.75rem; border-radius: 2px; }

.service-body { padding: 18px; position: relative; display: flex; flex-direction: column; flex: 1 1 0%; }

.service-icon { width: 35px; height: 35px; margin-bottom: 10px; }

.service p { margin: 9px 0px 17px; font-size: 0.925rem; }

.text-link { font-weight: 700; color: rgb(255, 102, 115); }

.text-link:hover { text-decoration: underline; }

.service a { margin-top: auto; align-self: start; font-size: 0.875rem; }

.more { display: flex; margin: 24px auto 0px; }

.split { display: grid; grid-template-columns: 1fr 1fr; background: rgb(21, 23, 28); border-block: 1px solid var(--line); min-height: 470px; }

.photo { position: relative; overflow: hidden; background: rgb(22, 24, 29); }

.photo img { width: 100%; height: 100%; object-fit: cover; position: absolute; inset: 0px; }

.split-copy { padding: clamp(32px, 6vw, 95px); align-self: center; }

.split-copy h2 { font-size: clamp(2.7rem, 4.7vw, 4.7rem); }

.split-copy > p:not(.eyebrow) { margin-top: 18px; }

.principles { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 23px; }

.principles span { font-size: 0.875rem; border-top: 1px solid rgb(55, 57, 66); border-right: 1px solid rgb(55, 57, 66); border-bottom: 1px solid rgb(55, 57, 66); border-image: none; border-left: 2px solid var(--red); padding: 5px 10px; }

.tech-layout { display: grid; grid-template-columns: 1.3fr 1fr; gap: 22px; }

.tech-photo { min-height: 355px; }

.tech-photo img { animation: 0.35s ease 0s 1 normal both running enter; }

.tech-options details { border-bottom: 1px solid var(--line); background: rgb(19, 21, 26); }

.tech-options summary { cursor: pointer; list-style: none; padding: 15px 20px; font-weight: 700; display: flex; justify-content: space-between; }

.tech-options summary::-webkit-details-marker { display: none; }

.tech-options summary::after { content: "+"; color: var(--accent); }

.tech-options details[open] summary::after { content: "âˆ’"; }

.tech-options p { padding: 0px 20px 15px; }

.gallery, .contact { background: rgb(17, 19, 24); border-block: 1px solid var(--line); }

.gallery-grid { display: grid; grid-template-columns: 1.35fr 1fr 1fr; gap: 12px; }

.gallery-item { color: white; border: 1px solid var(--line); background: rgb(24, 26, 31); text-align: left; padding: 0px; border-radius: 3px; overflow: hidden; }

.gallery-item img { aspect-ratio: 1.6 / 1; }

.gallery-item:first-child img { aspect-ratio: 2.16 / 1; }

.gallery-name { padding: 10px 14px; display: block; font-weight: 700; }

dialog { background: rgb(17, 19, 24); color: white; border: 1px solid var(--line); border-radius: 5px; max-width: min(920px, 92vw); padding: 12px; }

dialog::backdrop { background: rgba(0, 0, 0, 0.867); }

dialog figure { position: relative; }

dialog img { max-height: 76vh; object-fit: contain; }

#close-viewer { display: block; margin: 0px 0px 8px auto; background: rgb(36, 38, 42); border: 1px solid rgb(101, 103, 109); color: white; width: 42px; height: 42px; font-size: 1.4rem; }

.booking-grid { display: grid; grid-template-columns: 0.85fr 1.15fr; gap: clamp(22px, 5vw, 75px); align-items: center; }

.booking p:not(.eyebrow), .contact p, .contact address { margin: 16px 0px; }

.contact address { font-style: normal; }

.booking form { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; padding: clamp(14px, 3vw, 30px); background: rgb(21, 23, 28); border-right-color: ; border-right-style: ; border-right-width: ; border-bottom-color: ; border-bottom-style: ; border-bottom-width: ; border-left-color: ; border-left-style: ; border-left-width: ; border-image-source: ; border-image-slice: ; border-image-width: ; border-image-outset: ; border-image-repeat: ; border-top: 2px solid var(--red); }

.booking label { display: block; font-size: 0.875rem; font-weight: 700; }

.booking input, .booking select, .booking textarea { display: block; width: 100%; min-width: 0px; margin-top: 5px; padding: 10px 11px; background: rgb(9, 10, 13); border: 1px solid rgb(68, 70, 83); color: white; border-radius: 3px; font-size: 1rem; }

.booking textarea { resize: vertical; }

.booking form .button { align-self: end; }

.wide { grid-column: 1 / -1; }

.reviews { display: flex; justify-content: space-between; align-items: center; padding-block: 35px; border-top: 1px solid var(--line); gap: 20px; }

.reviews h2 { font-size: clamp(2rem, 4vw, 3.25rem); }

.contact iframe { width: 100%; height: 330px; border: 1px solid var(--line); border-radius: 3px; }

.footer { min-height: 115px; padding-block: 15px; }

.floating { position: fixed; bottom: max(18px,env(safe-area-inset-bottom)); right: 18px; background: rgb(21, 108, 66); border: 1px solid rgb(60, 170, 114); color: rgb(255, 255, 255); z-index: 4; display: grid; place-items: center; width: 52px; height: 52px; border-radius: 50%; box-shadow: rgba(0, 0, 0, 0.6) 0px 8px 30px; }

.floating:hover { background: rgb(34, 124, 80); }

.motion-pending { clip-path: inset(0px 0px 12%); opacity: 0.15; transform: translateY(18px); }

.reveal { transition: clip-path 0.75s, opacity 0.7s, transform 0.7s; clip-path: inset(0px); opacity: 1; transform: none; }

@media (max-width: 1000px) {
  .wrap { width: calc(100% - 48px); }
  .nav-action { display: none; }
  .service-grid { grid-template-columns: repeat(2, minmax(0px, 1fr)); }
}

@media (max-width: 660px) {
  .wrap { width: calc(100% - 36px); }
  .nav { min-height: 66px; flex-wrap: wrap; gap: 0px; }
  .menu { display: block; color: white; background: rgb(24, 26, 31); border: 1px solid rgb(66, 67, 74); padding: 0.45rem 0.75rem; border-radius: 3px; }
  .nav nav { display: none; width: 100%; padding: 10px 0px 16px; flex-wrap: wrap; }
  .nav nav.open { display: flex; }
  .hero { min-height: 640px; align-items: end; }
  .hero-picture, .hero-picture::after { background-position: 64% 0px; background-size: auto 68%; }
  .hero-shade { background: linear-gradient(0deg, rgb(8, 9, 11) 10%, rgb(8, 9, 11) 28%, rgba(8, 9, 11, 0.533) 54%, transparent 78%); }
  .hero-content { padding: 220px 0px 80px; }
  .hero h1 { font-size: clamp(3.8rem, 12vw, 6rem); }
  .hero-copy { margin: 16px 0px 20px; }
  .hero-bottom { bottom: 15px; }
  .quick-grid { grid-template-columns: 1fr; }
  .quick-grid > * { padding: 11px 4px; border: 0px !important; }
  .quick-grid > * + * { border-top: 1px solid var(--line) !important; }
  .section-head, .reviews { align-items: flex-start; flex-direction: column; gap: 14px; }
  .split, .tech-layout, .booking-grid { grid-template-columns: 1fr; }
  .split > .photo { min-height: 235px; }
  .tech-photo { min-height: 235px; }
  .gallery-grid { grid-template-columns: 1fr 1fr; }
  .gallery-item:first-child { grid-column: 1 / -1; }
  .footer { flex-wrap: wrap; padding-right: 48px; }
  .footer p { order: 3; width: 100%; }
  .booking form { gap: 12px; }
  .booking form .button { min-height: 45px; }
  .contact iframe { height: 260px; }
}

@media (max-width: 365px) {
  .service-grid, .booking form { grid-template-columns: 1fr; }
}

@media (prefers-reduced-motion: reduce) {
  *, ::before, ::after { animation: auto ease 0s 1 normal none running none !important; transition: none !important; scroll-behavior: auto !important; }
  .hero-picture, .motion-pending { transform: none; opacity: 1; clip-path: none; }
}

@media (prefers-reduced-motion: no-preference) {
  .hero-picture { transform: translateY(var(--parallax,0px)) scale(var(--scroll-zoom,1)); }
  .tech-options details { animation: 0.7s ease 0s 1 normal both running enter; }
  .tech-options details:nth-child(2) { animation-delay: 0.1s; }
  .tech-options details:nth-child(3) { animation-delay: 0.18s; }
  .tech-options details:nth-child(4) { animation-delay: 0.26s; }
}
